@ExpenseHub_Api_HostAddress = http://localhost:5245

# Preencha antes de executar (não versione valores reais):
# - adminPassword: valor de SeedAdmin:Password (dotnet user-secrets list)
# - adminToken / userToken: copie o accessToken retornado pelo login
# - userId: id retornado pelo cadastro
@adminEmail = admin@expensehub.local
@adminPassword = <SENHA_DO_ADMIN>
@userEmail = ana@expensehub.local
@userPassword = <SENHA_DA_ANA>
@adminToken = <TOKEN_DO_ADMIN>
@userToken = <TOKEN_DA_ANA>
@userId = <ID_DA_ANA>

GET {{ExpenseHub_Api_HostAddress}}/health
Accept: application/json

### I02 — Login do Admin (200 com accessToken)
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### I02 — Login inválido (401, sem token)
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "senha-errada"
}

### I02 — Rota protegida sem token (401)
GET {{ExpenseHub_Api_HostAddress}}/api/me

### I02 — Usuário autenticado (200)
GET {{ExpenseHub_Api_HostAddress}}/api/me
Authorization: Bearer {{adminToken}}

### I03 — Cadastro público; o campo "roles" é ignorado (201, roles vazias)
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}",
  "roles": ["Admin"]
}

### I03 — Cadastro com e-mail inválido (400)
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "nao-e-email",
  "password": "{{userPassword}}"
}

### I03 — Listar usuários como Admin (200)
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{adminToken}}

### I03 — Listar usuários sem role Admin (403)
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{userToken}}

### I03 — Atribuir roles (200); o usuário precisa fazer login novamente
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{userId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Employee", "Approver"]
}

### I03 — Role desconhecida (400)
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{userId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["SuperUser"]
}

### I03 — Usuário inexistente (404)
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/nao-existe/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Employee"]
}

### I04 — Criar rascunho como Employee (201, status Draft, ownerId do token)
# Campos como ownerId/status enviados pelo cliente são ignorados.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "description": "Táxi do aeroporto até o cliente",
  "amount": 87.50,
  "expenseDate": "2026-10-08",
  "categoryId": 2,
  "ownerId": "outro-usuario",
  "status": "Paid"
}

### I04 — Valor zero, data futura e descrição curta (400)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "description": "curta",
  "amount": 0,
  "expenseDate": "2099-01-01",
  "categoryId": 2
}

### I04 — Editar rascunho próprio (200; 404 de outro Employee; 409 fora de Draft)
@expenseId = <ID_DO_REEMBOLSO>
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "description": "Táxi do aeroporto até o cliente (ida e volta)",
  "amount": 160.00,
  "expenseDate": "2026-10-08",
  "categoryId": 2
}

### I05 — Enviar rascunho próprio (200 Submitted; repetir → 409)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{userToken}}

### I05 — Listar conforme o perfil (Employee: próprios; Approver: Submitted; Finance: Approved/Paid; Auditor: todos)
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{userToken}}

### I05 — Admin sem role funcional não lista reembolsos (403)
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{adminToken}}

### I05 — Detalhe (200 se visível; 404 se inexistente ou fora do escopo)
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{userToken}}

### I07 — Aprovar como Approver não proprietário (200 Approved; repetir → 409; proprietário → 403)
@approverToken = <TOKEN_DO_APPROVER>
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/approve
Authorization: Bearer {{approverToken}}

### I07 — Reprovar com justificativa (200 Rejected)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/reject
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "justification": "Comprovante ilegível, reenvie em novo pedido."
}

### I07 — Justificativa curta (400)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/reject
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "justification": "não"
}

### I07 — Employee sem role Approver tentando aprovar (403)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/approve
Authorization: Bearer {{userToken}}

### I08 — Pagar reembolso aprovado como Finance não proprietário (200 Paid + payment; repetir → 409)
@financeToken = <TOKEN_DO_FINANCE>
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{financeToken}}

### I08 — Histórico (mesma visibilidade do reembolso; Auditor vê todos)
@auditorToken = <TOKEN_DO_AUDITOR>
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/history
Authorization: Bearer {{auditorToken}}

### I08 — Pagar reembolso ainda Submitted (409)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{financeToken}}
 
### I08 — Dono com role Finance pagando o próprio reembolso (403)
@ownerFinanceToken = <TOKEN_DO_DONO_COM_FINANCE>
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{ownerFinanceToken}}
 
### I08 — Histórico consultado por outro Employee (404)
@otherEmployeeToken = <TOKEN_DE_OUTRO_EMPLOYEE>
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/history
Authorization: Bearer {{otherEmployeeToken}}

### CP3 — Relatórios: variáveis (preencha antes de executar; não versione valores reais)
# - employeeToken / employee2Token: login de duas contas com role Employee (depois de atribuir a role, faça login de novo)
# - auditorToken: já declarado acima (conta com role Auditor)
# - reportId: id devolvido pelo POST Mine da employee; pendingReportId: id de um relatório ainda Pending
@employeeToken = <TOKEN_DA_EMPLOYEE>
@employee2Token = <TOKEN_DA_OUTRA_EMPLOYEE>
@reportId = <ID_DO_RELATORIO>
@pendingReportId = <ID_DE_RELATORIO_PENDING>

### CP3 — Solicitar relatório Mine como Employee (202 + Location: /api/reports/{id})
POST {{ExpenseHub_Api_HostAddress}}/api/reports
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "fromDate": "2026-09-01",
  "toDate": "2026-09-30",
  "scope": "Mine"
}

### CP3 — Solicitar relatório Global como Auditor (202)
POST {{ExpenseHub_Api_HostAddress}}/api/reports
Authorization: Bearer {{auditorToken}}
Content-Type: application/json

{
  "fromDate": "2026-09-01",
  "toDate": "2026-09-30",
  "scope": "Global"
}

### CP3 — Employee solicitando Global (403)
POST {{ExpenseHub_Api_HostAddress}}/api/reports
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "fromDate": "2026-09-01",
  "toDate": "2026-09-30",
  "scope": "Global"
}

### CP3 — Data inicial maior que a final (400, sem criar solicitação)
POST {{ExpenseHub_Api_HostAddress}}/api/reports
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "fromDate": "2026-09-30",
  "toDate": "2026-09-01",
  "scope": "Mine"
}

### CP3 — Escopo inválido (400)
POST {{ExpenseHub_Api_HostAddress}}/api/reports
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "fromDate": "2026-09-01",
  "toDate": "2026-09-30",
  "scope": "Team"
}

### CP3 — Solicitar relatório sem token (401)
POST {{ExpenseHub_Api_HostAddress}}/api/reports
Content-Type: application/json

{
  "fromDate": "2026-09-01",
  "toDate": "2026-09-30",
  "scope": "Mine"
}

### CP3 — Listar relatórios (200, somente os do próprio usuário, mais recentes primeiro)
GET {{ExpenseHub_Api_HostAddress}}/api/reports
Authorization: Bearer {{employeeToken}}

### CP3 — Detalhe pelo dono (200; Pending/Processing/Completed com resultado salvo ou Failed com erro)
GET {{ExpenseHub_Api_HostAddress}}/api/reports/{{reportId}}
Authorization: Bearer {{employeeToken}}

### CP3 — Detalhe consultado por outra Employee (404)
GET {{ExpenseHub_Api_HostAddress}}/api/reports/{{reportId}}
Authorization: Bearer {{employee2Token}}

### CP3 — Detalhe consultado por Auditor que não criou o relatório (404)
GET {{ExpenseHub_Api_HostAddress}}/api/reports/{{reportId}}
Authorization: Bearer {{auditorToken}}

### CP3 — Download Excel de relatório concluído (200, arquivo report-{id}.xlsx)
GET {{ExpenseHub_Api_HostAddress}}/api/reports/{{reportId}}/excel
Authorization: Bearer {{employeeToken}}

### CP3 — Download Excel de relatório ainda Pending (409)
GET {{ExpenseHub_Api_HostAddress}}/api/reports/{{pendingReportId}}/excel
Authorization: Bearer {{employeeToken}}

### CP3 — Download Excel do relatório de outro usuário (404)
GET {{ExpenseHub_Api_HostAddress}}/api/reports/{{reportId}}/excel
Authorization: Bearer {{employee2Token}}
