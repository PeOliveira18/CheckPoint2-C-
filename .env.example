# Copie para .env (que não é versionado) e troque os placeholders.
#   cp .env.example .env

# Tag das imagens no GHCR: SHA completo do commit publicado pelo workflow "publish".
IMAGE_TAG=<SHA_DO_COMMIT>

# Oracle da FIAP (externo ao Compose); web e worker usam a mesma conexão.
EXPENSEHUB_CONNECTION_STRING="User Id=<RM>;Password=<SENHA>;Data Source=oracle.fiap.com.br:1521/ORCL"

# Usuário do RabbitMQ criado no primeiro start do volume.
RABBITMQ_USER=expensehub
RABBITMQ_PASSWORD=<SENHA_DO_RABBITMQ>

# Somente a API. Chave com 32+ caracteres (ex.: openssl rand -base64 48).
JWT_SIGNING_KEY=<CHAVE_JWT>
SEED_ADMIN_PASSWORD=<SENHA_DO_ADMIN>
